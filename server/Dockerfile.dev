# Development image for Strapi
# Does NOT build the admin bundle — strapi develop handles that at runtime.
FROM public.ecr.aws/docker/library/node:22-alpine

RUN apk update && apk upgrade --no-cache

WORKDIR /app

# Install dependencies first (cached layer — only re-runs if package.json changes)
COPY package*.json ./
RUN npm ci

# Copy the rest of the source (will be overwritten by `docker compose watch` syncs)
COPY . .

EXPOSE 1337

# Vite's optimized admin chunks are generated in node_modules/.strapi and can
# reference hashes from a previous dependency or Strapi build.
CMD ["sh", "-c", "rm -rf /app/node_modules/.strapi/vite /app/node_modules/.strapi/deps-check.hash && npm run develop"]
